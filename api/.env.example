DATABASE_URL=postgresql://arrowfin:arrowfin@localhost:5432/arrowfin
# Dev-only secret. Generate a real one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# "Now" for the dataset cut. In production this would be the real clock.
SNAPSHOT_AS_OF=2026-08-25T14:30:00Z
WEB_ORIGIN=http://localhost:3000
# Enables POST /dev/fills. Must never be set in production.
ENABLE_DEV_FILLS=true
